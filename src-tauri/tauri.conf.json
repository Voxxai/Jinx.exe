{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jinx.exe",
  "version": "0.1.0",
  "identifier": "nl.voxxai.jinxexe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jinx.exe",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "A chaotic stream-aware desktop companion",
    "longDescription": "A desktop companion that reacts to Twitch, OBS, music and stream events."
  }
}
